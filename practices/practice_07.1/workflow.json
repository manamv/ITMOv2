        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'openai/gpt-5',\n  messages: [\n    { role: 'system', content: 'Ты ведущий Security & Reliability Auditor. Проведи точечный аудит безопасности блока кода из файла ' + $json.path + ' (строка ' + $json.line + '). Сфокусируйся на валидации, уязвимостях и надежности. Ответ дай кратко на русском языке (2-4 предложения).' },\n    { role: 'user', content: 'Вот фрагмент diff блока кода:\\n\\n' + $json.code }\n  ],\n  temperature: 0.7\n}) }}",
        "options": {}
      },
      "id": "node-llm-2",
      "name": "Model 2: Security Auditor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/{{ $('Split Diff Into Blocks').item.json.repo }}/pulls/{{ $('Split Diff Into Blocks').item.json.pr_number }}/comments",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-bot"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  body: '🤖 **' + ($('GitHub Webhook').item.json.body.comment.body.includes('/make_other_ai_review') ? 'Модель 2 (Security Audit)' : 'Основная модель (GPT-5)') + ' ревью блока:**\\n\\n' + $json.choices[0].message.content,\n  commit_id: $('Split Diff Into Blocks').item.json.commit_id,\n  path: $('Split Diff Into Blocks').item.json.path,\n  line: $('Split Diff Into Blocks').item.json.line,\n  side: 'RIGHT'\n}) }}",
        "options": {}
      },
      "id": "node-post-inline",
      "name": "Post Inline Review Comment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2240,
        280
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "dataTableId": "reviewed_prs",
        "fields": {
          "values": [
            {
              "field": "pr_id",
              "value": "={{ $('GitHub Webhook').item.json.body.issue.number }}"
            },
            {
              "field": "model",
              "value": "={{ $('GitHub Webhook').item.json.body.comment.body.includes('/make_other_ai_review') ? 'gpt-5-security' : 'gpt-5' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-save-db",
      "name": "Save to Data Table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        2480,
        280
      ]
    }
