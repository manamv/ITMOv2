    {
      "parameters": {
        "jsCode": "const comment = $('GitHub Webhook').first().json.body.comment.body;\nconst currentPr = Number($('GitHub Webhook').first().json.body.issue.number);\nconst tableRows = $('Check Data Table').all();\n\nconst requestedModel = comment.includes('/make_other_ai_review') ? 'gpt-5-security' : 'gpt-5';\n\nconst isAlreadyReviewed = tableRows.some(row => \n  Number(row.json.pr_id) === currentPr && row.json.model === requestedModel\n);\n\nif (isAlreadyReviewed) {\n  return [];\n}\n\nreturn [{ json: { pr_id: currentPr, model: requestedModel } }];"
      },
