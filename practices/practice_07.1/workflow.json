      "id": "c3c21b08-7efd-4772-9f1f-44763bc4e3cc",
      "name": "Get PR Diff",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1104,
        128
      ],
      "credentials": {
        "githubApi": {
          "id": "mBxuLumW8SRSPXFz",
          "name": "GitHub account 22"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const diffText = $('Get PR Diff').item.json.data || '';\nconst commitId = $('Get PR Details (Commit SHA)').item.json.head.sha;\nconst repoFullName = $('GitHub Webhook').item.json.body.repository.full_name;\nconst prNumber = $('GitHub Webhook').item.json.body.issue.number;\n\nconst blocks = [];\nconst lines = diffText.split('\\n');\nlet currentFile = '';\nlet currentHunk = [];\nlet targetLine = null;\nlet currentNewLine = 0;\n\nfunction pushBlock() {\n  if (currentFile && currentHunk.length > 0 && targetLine !== null) {\n    blocks.push({\n      json: {\n        path: currentFile,\n        line: targetLine,\n        code: currentHunk.join('\\n'),\n        commit_id: commitId,\n        repo: repoFullName,\n        pr_number: prNumber\n      }\n    });\n  }\n  currentHunk = [];\n  targetLine = null;\n}\n\nfor (let i = 0; i < lines.length; i++) {\n  const line = lines[i];\n\n  if (line.startsWith('diff --git ')) {\n    pushBlock();\n    const match = line.match(/b\\/(.+)$/);\n    currentFile = match ? match[1].trim() : '';\n  } else if (line.startsWith('@@ ')) {\n    pushBlock();\n    const match = line.match(/@@ -\\d+(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/);\n    if (match) {\n      currentNewLine = parseInt(match[1], 10);\n    }\n    currentHunk.push(line);\n  } else if (currentHunk.length > 0) {\n    currentHunk.push(line);\n    if (line.startsWith('+') && !line.startsWith('+++')) {\n      targetLine = currentNewLine;\n      currentNewLine++;\n    } else if (!line.startsWith('-')) {\n      currentNewLine++;\n    }\n  }\n}\npushBlock();\n\nif (blocks.length === 0) {\n  return [{\n    json: {\n      path: '',\n      line: 0,\n      code: diffText,\n      commit_id: commitId,\n      repo: repoFullName,\n      pr_number: prNumber,\n      is_fallback: true\n    }\n  }];\n}\n\nreturn blocks;"
      },
